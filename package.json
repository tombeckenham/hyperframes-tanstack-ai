{
  "name": "hyperframes-tanstack-ai",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/server/index.js",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.3",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@hyperframes/core": "^0.5.4",
